{
  "name": "cascade-routing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Where should the next euro go? A measured cascade: rules, a small model, a large one, a human.",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "premiere-reponse": "node src/premiere-reponse.mjs",
    "measure": "node src/measure.ts",
    "optimise": "node src/optimise.ts",
    "typage": "tsc --noEmit",
    "test": "tsc --noEmit && node src/readme.ts --check && node src/landing.ts --check && node src/dossier.ts --check && node src/sonde.ts --check && node src/licences.ts --check && node src/menace.ts --check && node --test src/*.test.ts src/*.test.mjs",
    "failures": "node src/failures.ts",
    "figures": "node src/readme.ts && node src/landing.ts",
    "landing": "node src/landing.ts",
    "derivees": "node src/landing.ts --derivees",
    "sensitivity": "node src/sensitivity.ts",
    "prompt": "node src/sensibilite-prompt.ts",
    "regler": "node src/regler-prompt.ts",
    "apparier": "node src/apparier-prompt.ts",
    "departager": "node src/departager-reglage.ts",
    "tentatives": "node src/tentatives.ts",
    "dur": "node src/mesurer-dur.ts",
    "mur": "node src/mur.ts",
    "signal": "node src/signal.ts",
    "escalade": "node src/escalade.ts",
    "abstention": "node src/abstention.ts",
    "start": "node src/server.ts",
    "pages": "tsc -p tsconfig.web.json && node src/pages.ts && node src/verifier-ecran.mjs . 2",
    "captures": "node src/capturer.mjs .",
    "dossier": "node src/dossier.ts",
    "measure:yours": "node src/your-cases.ts",
    "recertify": "node src/recertify.ts",
    "fuite": "node src/fuite.ts",
    "benchmark": "node src/benchmark.ts",
    "egress": "node src/egress.ts",
    "intake": "node src/intake.ts",
    "clone-neuf": "node src/clone-neuf.mjs",
    "contrainte": "node src/contrainte.ts",
    "sceller": "node src/sceller.ts",
    "diff": "node src/diff.ts",
    "entree": "node src/entree.ts",
    "sonde": "node src/sonde.ts",
    "ocr": "node src/mesurer-ocr.ts",
    "licences": "node src/licences.ts",
    "poids": "node src/poids.ts",
    "menace": "node src/menace.ts",
    "hostile": "node src/hostile.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "4.2.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.9.0"
  },
  "overrides": {
    "sharp": "^0.35.3",
    "adm-zip": "^0.6.0"
  },
  "license": "PolyForm-Noncommercial-1.0.0"
}
