{
  "name": "cascade-routing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Where should the next euro go? A measured cascade: rules, a small model, a large one, a human.",
  "scripts": {
    "measure": "node src/measure.ts",
    "optimise": "node src/optimise.ts",
    "typage": "tsc --noEmit",
    "test": "tsc --noEmit && node src/readme.ts --check && node src/landing.ts --check && node --test src/*.test.ts",
    "failures": "node src/failures.ts",
    "figures": "node src/readme.ts && node src/landing.ts",
    "landing": "node src/landing.ts",
    "sensitivity": "node src/sensitivity.ts",
    "prompt": "node src/sensibilite-prompt.ts",
    "regler": "node src/regler-prompt.ts",
    "apparier": "node src/apparier-prompt.ts",
    "departager": "node src/departager-reglage.ts",
    "tentatives": "node src/tentatives.ts",
    "dur": "node src/mesurer-dur.ts",
    "mur": "node src/mur.ts",
    "signal": "node src/signal.ts",
    "escalade": "node src/escalade.ts",
    "start": "node src/server.ts",
    "pages": "tsc -p tsconfig.web.json && node src/pages.ts && node src/verifier-ecran.mjs . 2",
    "captures": "node src/capturer.mjs .",
    "dossier": "node src/dossier.ts",
    "measure:yours": "node src/your-cases.ts",
    "fuite": "node src/fuite.ts",
    "benchmark": "node src/benchmark.ts",
    "egress": "node src/egress.ts",
    "intake": "node src/intake.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.0.0"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "@types/node": "^24.0.0"
  }
}
