#!/bin/sh
#
# QUI A POUSSÉ, ET QUAND.
#
# Le 24 août 2026, dix-sept dépôts sont partis en ligne entre 01:51 et 02:59 depuis cette
# machine. Personne n'a pu dire qui : toutes les sessions committent et poussent sous la même
# identité git, le territoire ne dit plus qui écrit, et l'horodatage seul a fait attribuer
# deux fois de suite un travail au mauvais auteur.
#
# Ce crochet ne juge rien et ne bloque JAMAIS — une garde qui empêche une poussée légitime se
# fait retirer, et on perdrait aussi la trace. Il écrit une ligne, et sort à zéro quoi qu'il
# arrive.
#
# Ce qu'il enregistre en plus de la date : la chaîne des processus parents. C'est le seul
# élément qui sépare deux sessions partageant tout le reste.
JOURNAL="$HOME/Documents/rapports/poussees.log"
# Le dossier d'abord. Sans lui la redirection échoue, la poussée aboutit quand même, et
# l'absence de ligne se lit comme une absence de poussée — le silence exact que ce crochet
# existe pour empêcher. Signalé par une session pair qui a monté le cas plutôt que le supposer.
mkdir -p "$(dirname "$JOURNAL")" 2>/dev/null
{
  DEPOT=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null)
  TETE=$(git rev-parse --short HEAD 2>/dev/null)
  # La chaîne des parents, remontée tant qu'il y en a une.
  CHAINE=""; P=$PPID; N=0
  while [ -n "$P" ] && [ "$P" -gt 1 ] && [ $N -lt 6 ]; do
    NOM=$(ps -o comm= -p "$P" 2>/dev/null | sed 's|.*/||')
    [ -z "$NOM" ] && break
    CHAINE="$CHAINE$NOM($P)<-"
    P=$(ps -o ppid= -p "$P" 2>/dev/null | tr -d ' ')
    N=$((N + 1))
  done
  # `tty` sort en erreur ET écrit « not a tty » : sans ça la ligne se coupait en deux, et un
  # journal dont une entrée tient sur deux lignes ne se relit plus à la commande.
  TTY=$(tty 2>/dev/null)
  case "$TTY" in "" | *"not a tty"*) TTY="aucun" ;; esac
  printf '%s  %-16s HEAD=%-10s tty=%-12s %s\n' \
    "$(date '+%Y-%m-%d %H:%M:%S')" "$DEPOT" "$TETE" "$TTY" "$CHAINE"
} >> "$JOURNAL" 2>/dev/null
# ─── RIEN DE LICENCIÉ NE FRANCHIT CETTE LIGNE ───
#
# Ce dépôt est PUBLIC. Le composant licencié vit ailleurs — c'est ce qu'on vend, et il ne se
# republie pas. Avant la séparation des dépôts, ses fichiers ont vécu ici : la branche
# `avant-coupure-2026-08-24` les porte encore dans son historique, et retirer un fichier de
# HEAD ne le retire pas du dépôt. Un `git push` de cette branche les publie pour toujours.
#
# Trouvé le 25 août 2026 par une session pair, avec 110 commits en attente de poussée. Le
# crochet journalisait et rendait 0 : il n'y avait AUCUN mécanisme entre ces fichiers et le
# public, seulement l'intention de ne pas se tromper de branche.
#
# LA LISTE EST DÉRIVÉE DU DÉPÔT LICENCIÉ, PAS ÉCRITE ICI. Une liste écrite à la main oublie
# le fichier ajouté demain — c'est la faute que ce dépôt passe ses journées à corriger. Et si
# la dérivation ne marche pas, on REFUSE : un contrôle qui ne sait pas ce qu'il protège ne
# doit pas rendre « rien à signaler ».
LICENCIE="$HOME/Documents/cascade-licencie/src"
if [ ! -d "$LICENCIE" ]; then
  echo "" >&2
  echo "  DÉPÔT LICENCIÉ INTROUVABLE — impossible de savoir ce qui ne doit pas sortir." >&2
  echo "  Cherché : $LICENCIE" >&2
  echo "" >&2
  echo "  → clonez-le à côté, ou   git push --no-verify   si vous savez pourquoi." >&2
  exit 1
fi
NOMS=$(ls "$LICENCIE" | grep -E '\.ts$' | grep -v '\.test\.ts$')
if [ -z "$NOMS" ]; then
  echo "  aucun module licencié trouvé dans $LICENCIE : la dérivation ne marche plus, on refuse." >&2
  exit 1
fi

# L'ENTRÉE SE LIT UNE FOIS. Deux boucles la consomment maintenant, et la seconde recevait un
# flux vide — donc « rien à signaler » sans avoir rien lu.
PORTEES=$(mktemp)
cat > "$PORTEES"

TROUVES=""
while read -r ref_local sha_local ref_dist sha_dist; do
  [ "$sha_local" = "0000000000000000000000000000000000000000" ] && continue   # suppression
  # Une nouvelle branche n'a pas de « depuis » : on regarde tout son historique.
  case "$sha_dist" in
    0000000000000000000000000000000000000000) PORTEE="$sha_local --not --remotes" ;;
    *) PORTEE="$sha_dist..$sha_local" ;;
  esac
  for n in $NOMS; do
    if git log --oneline $PORTEE --name-only -- "src/$n" 2>/dev/null | grep -q "^src/$n$"; then
      TROUVES="$TROUVES\n    src/$n  (dans $ref_local)"
    fi
  done
done < "$PORTEES"

if [ -n "$TROUVES" ]; then
  echo "" >&2
  echo "  POUSSÉE REFUSÉE — du code licencié est dans l'historique de ce qui partirait." >&2
  printf "%b\n" "$TROUVES" >&2
  echo "" >&2
  echo "  Ce dépôt est public. Retirer un fichier de HEAD ne le retire pas du dépôt :" >&2
  echo "  quiconque clone récupère l'objet, et une publication ne se rattrape pas." >&2
  echo "" >&2
  echo "  → ne poussez PAS cette branche. Poussez « main », qui n'en porte aucun." >&2
  echo "  → ou réécrivez l'historique de la branche avant de la pousser." >&2
  echo "  → git push --no-verify   passe outre, et publie. Il n'y a pas de retour." >&2
  exit 1
fi

# ─── RIEN D'IGNORÉ NE PART, ET LA LISTE VIENT DE `.gitignore` ───
#
# `.stryker-tmp/sandbox-mPFFL7/` — cent cinquante-neuf fichiers, une copie entière du dépôt
# laissée par une passe de mutation — vit dans l'historique de deux branches de sauvegarde,
# avec un lien symbolique `node_modules` qui pointe vers le chemin absolu du disque de
# l'auteur. Rien de tout ça n'est publié aujourd'hui : ces commits ne sont atteignables ni
# depuis `origin/main` ni depuis aucune référence du distant. **Un `git push --all` les
# publierait**, et retirer un fichier de HEAD ne le retire pas du dépôt.
#
# LA RÈGLE SE DÉDUIT, ELLE NE S'ÉCRIT PAS ICI : ce que `.gitignore` refuse n'a rien à faire
# dans un historique public. Une liste de motifs tapée dans ce crochet oublierait le dossier
# de demain, et c'est la faute que ce dépôt passe ses journées à corriger.
#
# Mesuré avant de poser la garde : sur les 179 chemins que l'historique de `origin/main` a
# jamais ajoutés, **zéro** est ignoré aujourd'hui. Elle ne bloque donc rien de ce qui se
# pousse normalement.
IGNORES=""
while read -r ref_local sha_local ref_dist sha_dist; do
  [ "$sha_local" = "0000000000000000000000000000000000000000" ] && continue
  case "$sha_dist" in
    0000000000000000000000000000000000000000) PORTEE="$sha_local --not --remotes" ;;
    *) PORTEE="$sha_dist..$sha_local" ;;
  esac
  AJOUTES=$(git log $PORTEE --pretty=format: --name-only --diff-filter=A 2>/dev/null | sort -u | grep -v '^$')
  [ -z "$AJOUTES" ] && continue
  # `--no-index` N'EST PAS UN DÉTAIL : sans lui, `check-ignore` répond « pas ignoré » pour
  # tout fichier SUIVI — et un bac commité par erreur est suivi, par définition. Le contrôle
  # rendait donc zéro sur le cas exact qu'il vise. Mesuré sur un dépôt fabriqué.
  VUS=$(printf '%s\n' "$AJOUTES" | git check-ignore --no-index --stdin 2>/dev/null | head -20)
  if [ -n "$VUS" ]; then
    IGNORES="$IGNORES\n  dans $ref_local :\n$(printf '%s\n' "$VUS" | sed 's/^/    /')"
  fi
done < "$PORTEES"
rm -f "$PORTEES"

if [ -n "$IGNORES" ]; then
  echo "" >&2
  echo "  POUSSÉE REFUSÉE — des fichiers que .gitignore refuse sont dans ce qui partirait." >&2
  printf "%b\n" "$IGNORES" >&2
  echo "" >&2
  echo "  Ce dépôt est public. Un dossier ignoré qui a été commité une fois reste dans les" >&2
  echo "  objets : retirer le fichier de HEAD ne le retire pas du dépôt, et un bac de mutation" >&2
  echo "  porte des chemins absolus — donc le nom de l'utilisateur de la machine." >&2
  echo "" >&2
  echo "  → poussez la branche qui n'en porte pas (souvent « main »)." >&2
  echo "  → ou réécrivez l'historique de celle-ci avant de la pousser." >&2
  echo "  → git push --no-verify   passe outre, et publie. Il n'y a pas de retour." >&2
  exit 1
fi

# ─── POUSSER DEMANDE L'ACCORD ÉCRIT D'ARSLANE, ET C'EST LA RÈGLE LA PLUS ANCIENNE ───
#
# « Trois choses ont besoin de mon accord à moi : pousser ou publier, effacer quoi que ce soit,
# et tout ce qui touche à l'argent. Une permission donnée une fois ne vaut pas pour la suivante. »
#
# Cette règle a tenu cent quarante commits sans faille — mais elle tenait dans la mémoire d'une
# session, et une mémoire ne survit pas à la session suivante. Une session neuve qui trouve un
# dépôt avec un distant configuré n'a aucune raison de deviner qu'il ne faut pas pousser.
#
# Ce n'est pas un verrou : c'est un ralentisseur qui force la décision à être explicite. Le
# passage demande de nommer l'accord au moment de pousser, ce qu'on ne fait pas par distraction.
if [ -z "$ACCORD_ARSLANE" ]; then
  echo "" >&2
  echo "  POUSSÉE REFUSÉE — publier demande l'accord d'Arslane, à chaque fois." >&2
  echo "" >&2
  echo "  Ce dépôt est public. Ce qui part ne revient pas, et une permission donnée" >&2
  echo "  une fois ne vaut pas pour la suivante." >&2
  echo "" >&2
  echo "  Commits en attente : $(git rev-list --count @{u}..HEAD 2>/dev/null || echo '?')" >&2
  echo "" >&2
  echo "  → quand l'accord est donné :   ACCORD_ARSLANE=oui git push" >&2
  echo "  → git push --no-verify   passe outre, et publie sans accord." >&2
  exit 1
fi

exit 0
