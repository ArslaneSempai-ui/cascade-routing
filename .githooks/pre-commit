#!/bin/sh
#
# ET LA SUITE, PARCE QUE J'AI COMMITÉ ROUGE TROIS FOIS EN UNE JOURNÉE.
#
# Ce crochet ne lançait que les contrôles de documents engendrés — treize secondes, ce qui
# était le bon arbitrage tant que la suite en prenait quarante. Elle en prend trente
# aujourd'hui, et trois commits sont partis avec un cas rouge dedans parce que je ne l'avais
# pas lancée. « Je la lance toujours avant » est une intention ; un crochet n'en est pas une.
#
# `--no-verify` reste là pour qui sait pourquoi il passe outre.
#
# CE DÉPÔT LIVRE DES DOCUMENTS ENGENDRÉS, ET ILS SE PÉRIMENT EN SILENCE.
#
# README.md, landing.json, VALIDATION.md et SONDE.md sont écrits par le code. Un commit qui
# change le code sans les régénérer livre une page qui ment — c'est déjà arrivé, et la garde
# qui l'attrape vit dans `npm test`, donc APRÈS le moment où l'on commite.
#
# Le 24 août 2026, un commit est parti avec le README périmé parce que la commande qui le
# vérifiait était séparée du `git commit` par un point-virgule au lieu d'un `&&`. La règle
# existait, elle attendait qu'on s'en souvienne. Celle-ci se déclenche.
#
# Elle ne remplace pas `npm test` : elle ne joue AUCUN cas. Elle vérifie seulement que les
# documents livrés correspondent au code — treize secondes, la partie qui se périme.
#
# Pour passer outre une fois : git commit --no-verify
# ─── UN ROUGE QUI MENT COÛTE PLUS CHER QU'UN REFUS DE DÉMARRER ───
#
# Plusieurs bornes de ce dépôt comptent un TEMPS RÉEL. Sous forte charge — plusieurs sessions
# lançant leur suite en parallèle — un fil met des secondes à recevoir son tour, et aucune
# borne en temps réel ne tient. Mesuré le 25 août 2026 à une charge de 33,7 sur dix cœurs :
# sept cas rouges d'affilée, dont un à 50 secondes, puis sept verts en relançant seul.
#
# Élargir les bornes serait l'élargissement gratuit. On refuse de démarrer, en le disant.
# ─── LA CONFIGURATION DU DÉPÔT SE FAIT CORROMPRE, ET SILENCIEUSEMENT ───
#
# Deux fois le 26 août 2026, `.git/config` de ce dépôt s'est retrouvé avec `bare = true` et une
# section `[user] t <t@t>` venue de nulle part. Conséquences vécues : `git status` refuse de
# tourner pour les cinq sessions à la fois, et treize commits partent signés d'un nom faux —
# il a fallu réécrire l'historique pour les reprendre.
#
# La cause exacte n'est pas établie, et on ne l'attend pas pour se protéger. Ce contrôle
# RÉPARE et le DIT : une corruption silencieuse qu'on découvre une heure plus tard coûte cent
# fois une ligne de sortie. Il tourne en tête, avant tout le reste, parce qu'un dépôt marqué
# nu fait échouer tout ce qui suit avec des messages qui n'ont aucun rapport.
if [ "$(git config --get core.bare)" = "true" ]; then
  git config --unset core.bare
  printf '\n  RÉPARÉ : ce dépôt était marqué `bare = true` et ne pouvait plus rien faire.\n'
  printf '  Ce n était pas vous. La cause n est pas établie ; dites-le à la session qui coordonne.\n\n'
fi
if git config --local --get user.email >/dev/null 2>&1; then
  ancienne=$(git config --local --get user.email)
  git config --remove-section user 2>/dev/null
  printf '\n  RÉPARÉ : ce dépôt portait une identité locale `%s` qui gagnait sur la vôtre.\n' "$ancienne"
  printf '  Vérifiez `git log --format=%%an` sur vos derniers commits — ils peuvent être mal signés.\n\n'
fi

CHARGE=$(uptime | sed -E 's/.*averages?: *([0-9.]+).*/\1/' | tr -d ' ')
COEURS=$(sysctl -n hw.ncpu 2>/dev/null || nproc 2>/dev/null || echo 4)
if [ "$(echo "$CHARGE > $COEURS * 2" | bc -l 2>/dev/null || echo 0)" = "1" ]; then
  echo
  echo "  CHARGE $CHARGE SUR $COEURS CŒURS — la suite mentirait."
  echo
  echo "    Plusieurs bornes de ce dépôt comptent un temps réel. À ce régime, des cas"
  echo "    parfaitement bons tombent, avec des durées absurdes et des cas différents à"
  echo "    chaque passe. Un rouge qui ment coûte plus cher qu'un refus de démarrer."
  echo
  echo "  → attendez que la charge retombe sous $((COEURS * 2)), puis recommencez."
  echo "  → si vous savez pourquoi vous passez outre : git commit --no-verify"
  exit 1
fi

echo "  contrôle des documents engendrés…"
# Les contrôles de documents lancent git pour lire des empreintes de commit : eux aussi doivent
# ignorer l'index du commit en cours. Aucune exception — tout ce que le crochet lance.
if ! (env -u GIT_INDEX_FILE sh -c 'node src/readme.ts --check && node src/landing.ts --check \
      && node src/dossier.ts --check && node src/sonde.ts --check') > /tmp/cascade-pre-commit.log 2>&1; then
  echo ""
  echo "  DOCUMENT ENGENDRÉ PÉRIMÉ — ce commit livrerait une page qui ne suit plus le code."
  echo ""
  sed 's/^/    /' /tmp/cascade-pre-commit.log
  echo ""
  echo "  → npm run figures    puis recommencer."
  echo "  → git commit --no-verify   si vous savez pourquoi vous passez outre."
  exit 1
fi

# ─── CE CROCHET CONTRÔLE L'ARBRE DE TRAVAIL, DONC LE COMMIT DOIT LUI ÊTRE ÉGAL ───
#
# Tout ce qui précède et tout ce qui suit lit les fichiers SUR LE DISQUE. Si un fichier
# modifié n'est pas dans l'index, le crochet valide une chose et git en enregistre une autre.
#
# Payé le 25 août 2026, et trouvé par une session voisine, pas par moi : le commit `a0fb723`
# est parti sans `README.md` ni `failures-reference.json`, tous deux régénérés juste avant.
# Chez moi tout était vert ; dans un clone neuf de ce commit, `readme.ts --check` sortait 1 et
# la galerie versionnée échouait. J'avais publié un état qui ne tenait pas debout tout seul.
#
# La cause est le revers d'une bonne règle : on ajoute les fichiers PAR LEUR NOM, jamais avec
# `-A`, pour ne pas emporter le travail en cours d'une autre session. Une liste écrite à la
# main oublie — c'est la faute que ce dépôt passe ses journées à corriger ailleurs. Il lui
# manquait sa moitié : quelque chose qui confronte la liste à ce qui a bougé.
#
# On ne devine pas ce qui est « engendré » : toute modification non indexée fait refuser, avec
# la liste. Une liste de fichiers engendrés serait exactement la liste écrite à la main qui a
# causé le problème.
# AJOUT DU 25 AOÛT 2026 — deux commits VIDES sont passés ce jour-là : 0345143 (le mien) et
# 86c514a (une session voisine), tous deux portant un message qui décrivait un correctif réel.
# Le correctif du crochet que 0345143 prétendait porter n existe dans AUCUN commit du dépôt :
# seul son message existe. Cinq reproductions ont échoué — je ne sais pas par quelle route git
# les a acceptés. Cette garde ne dépend pas de la route : ce qui n emporte rien est refusé.
#
# Et git commit -- <chemins> n est PAS la parade au -A. Mesuré : il lit l ARBRE DE TRAVAIL et
# non l index, et il VIDE l index des chemins nommés. Une version soigneusement indexée
# disparaît sans un mot. La forme sûre est un worktree par session : l index y est à vous.
# LA BASE DÉPEND DE `--amend`, ET LA PREMIÈRE VERSION L'IGNORAIT. Pendant un amend, l'index est
# identique à HEAD — seul le message change — donc `git diff --cached` est vide et la garde
# refusait une opération parfaitement légitime, sans autre issue que `--no-verify`. Un refus sans
# issue se contourne, et une garde contournée ne garde plus rien. Le commit d'un amend porte en
# réalité ce que HEAD porte face à SON parent : c'est cette comparaison-là qu'il faut faire.
base=HEAD
if ps -o args= -p $PPID 2>/dev/null | grep -q -- "--amend" && git rev-parse -q --verify HEAD^ >/dev/null; then
  base="HEAD^"
fi
emporte=$(git diff --cached --name-only "$base")
if [ -z "$emporte" ]; then
  printf "\n  CE COMMIT NE PORTE AUCUN FICHIER.\n\n"
  printf "    Git a accepté deux commits vides ce jour-là, avec des messages qui décrivaient\n"
  printf "    des correctifs réels. Un message sans contenu se relit comme un fait accompli,\n"
  printf "    et le correctif reste à faire sans que personne le sache.\n\n"
  printf "  → git status   pour voir où est passé votre travail.\n"
  printf "  → git add <vos fichiers>   puis recommencez.\n"
  exit 1
fi
printf "\n  CE COMMIT EMPORTE :\n"
printf "%s\n" "$emporte" | sed "s/^/    /"
printf "\n"

# La vérification ci-dessous ne regarde QUE les fichiers emportés. Sa version large refusait
# tout commit tant qu un fichier — n importe lequel — était modifié : à six sessions, chacune
# bloquait les cinq autres, et la sortie de secours était git reset, qui défait le travail.
listeEmportes=$(mktemp)
printf "%s\n" "$emporte" > "$listeEmportes"
naipas=$(git diff --name-only | grep -F -x -f "$listeEmportes" || true)
rm -f "$listeEmportes"
if [ -n "$naipas" ]; then
  printf '\n  MODIFICATION NON INDEXÉE — le crochet contrôle le disque, git enregistrerait autre chose.\n\n'
  printf '%s\n' "$naipas" | sed 's/^/    /'
  printf '\n  → git add <ces fichiers>   si le commit doit les emporter (souvent : un artefact régénéré).\n'
  printf '  → git stash push -- <fichiers>   si le commit ne doit PAS les emporter.\n'
  printf '  → git commit --no-verify   si vous savez pourquoi vous livrez un état non contrôlé.\n'
  exit 1
fi

# `.mjs` MANQUAIT : `npm test` lance `src/*.test.ts src/*.test.mjs`, le crochet seulement les
# premiers. Un fichier de cas en .mjs n'était donc contrôlé nulle part avant la chaîne publique.
printf '  suite de cas…\n'
# `env -u GIT_INDEX_FILE` — LA SUITE NE DOIT PAS VOIR L'INDEX DU COMMIT EN COURS.
# Git exporte GIT_INDEX_FILE à ses crochets. Tout ce que la suite lance en hérite, et
# `git clone --no-local` écrit sa copie de travail DANS cet index : celui du commit en cours
# est remplacé par celui du clone, vide. `git commit` réussit alors en n'emportant rien.
# Reproduit puis refermé dans les deux sens le 26 août 2026 — avec la variable, l'index est
# vidé par la suite ; sans elle, il survit intact. La cause est corrigée dans clone-neuf.mjs ;
# ceci protège des acteurs qu'on n'a pas encore écrits.
if ! sortie=$(env -u GIT_INDEX_FILE node --test src/*.test.ts src/*.test.mjs 2>&1); then
  #
  # UN ROUGE SOUS CHARGE N'EST PAS UN VERDICT — mesuré le 26 août 2026.
  #
  # Plusieurs bornes de ce dépôt comptent un TEMPS RÉEL. Le refus de démarrer au-dessus de
  # `cœurs × 2` ne suffit pas : à une charge de 18,93 sur dix cœurs — donc SOUS le seuil — le cas
  # « chaque route POST refuse un corps au-delà de la borne » a rendu 5 124 ms et bloqué un commit
  # parfaitement bon. Une session voisine a mesuré la même chose sur `serveur-bornes.test.ts`,
  # verte deux fois sur deux relancée seule.
  #
  # J'avais posé `cœurs × 2` sans le mesurer. Plutôt que de deviner un second chiffre, on demande
  # à la MESURE de trancher : les fichiers rouges sont relancés SEULS. Rouges seuls, c'est un vrai
  # défaut et on refuse. Verts seuls, la suite mentait — on passe, et on le dit fort, avec la
  # charge et le nom du cas. Refuser sur un mensonge coûte plus cher que de le nommer.
  #
  fichiers=$(printf '%s\n' "$sortie" | grep -oE '^test at (src/[^:]+)' | sed 's/^test at //' | sort -u)
  if [ -n "$fichiers" ]; then
    printf '  %s fichier(s) rouge(s) — relance seule pour distinguer la charge du défaut…\n' \
      "$(printf '%s\n' "$fichiers" | wc -l | tr -d ' ')"
    # `env -u` ICI AUSSI, ET C'EST LA LEÇON. Le correctif d'origine protégeait la suite
    # nominale et laissait cette relance nue. Une session voisine l'a mesuré vingt minutes plus
    # tard : un fichier rouge sous charge, la relance annoncée, et `clone-neuf.test.mjs` a écrit
    # dans l'index de SON arbre — emportant son travail indexé dans un commit nommé `base`, puis
    # échouant sur sa propre assertion de montage parce qu'il lisait un index qui n'était pas
    # le sien. LE CHEMIN DE DIAGNOSTIC EST CELUI QU'ON N'EMPRUNTE QUE QUAND ÇA VA DÉJÀ MAL,
    # donc celui qu'on éprouve le moins, donc celui où une protection manque sans se voir.
    if seul=$(env -u GIT_INDEX_FILE node --test $fichiers 2>&1); then
      printf '\n  LA SUITE A MENTI — DEUX CAUSES POSSIBLES, ET ELLES NE SE SOIGNENT PAS PAREIL.\n\n'
      printf '%s\n' "$sortie" | grep -E '^✖' | head -4 | sed 's/^/    /'
      printf '  Relancés seuls, ces fichiers passent. Le commit continue — mais LISEZ CECI avant\n'
      printf '  de conclure à la charge : trois sessions ont couru après la mauvaise cause.\n\n'
      printf '    CHARGE (ici %s) : ne fait tomber que des cas qui COMPTENT UN TEMPS RÉEL.\n' "$CHARGE"
      printf '      Aucune durée mesurée pendant cette fenêtre ne vaut quoi que ce soit.\n\n'
      printf '    ÉTAT PARTAGÉ : node --test lance les fichiers en PROCESSUS PARALLÈLES. Un cas qui\n'
      printf '      écrit dans l arbre vivant — un relevé, un fichier de données, un port fixe — le\n'
      printf '      donne à tous les autres pendant sa fenêtre, même s il restaure ensuite.\n\n'
      printf '  LE SIGNE QUI LES SÉPARE : un cas tombé qui ne compte AUCUN temps accuse un état\n'
      printf '  partagé, jamais la charge. Mesuré le 26 août 2026 : releve-scelle.test.ts écrivait\n'
      printf '  data/profiles.json à la racine et faisait tomber seuil.test.ts, qui ne fait que lire\n'
      printf '  et calculer — trois cas différents selon l instant, à s y méprendre avec la charge.\n'
      printf '  La charge se soigne par le seuil ; l état partagé par un bac à sable par cas, et\n'
      printf '  lui ne guérira pas tout seul.\n\n'
      ignores=$(printf '%s' "$seul" | grep -oE '^# skipped [0-9]+' | grep -oE '[0-9]+')
      [ "${ignores:-0}" != "0" ] && printf '  %s cas ignoré(s).\n' "$ignores"
      exit 0
    fi
    sortie="$seul"
  fi
  printf '\n  CAS ROUGE — ce commit emporterait un test qui échoue.\n\n'
  printf '%s\n' "$sortie" | grep -E '^✖|AssertionError' | head -8 | sed 's/^/    /'
  printf '\n  → corriger, ou   git commit --no-verify   si vous savez pourquoi.\n'
  exit 1
fi
ignores=$(printf '%s' "$sortie" | grep -oE '^# skipped [0-9]+' | grep -oE '[0-9]+')
[ "${ignores:-0}" != "0" ] && printf '  %s cas ignoré(s) — un cas qui ne regarde pas ne compte pas comme un cas passé.\n' "$ignores"

exit 0
